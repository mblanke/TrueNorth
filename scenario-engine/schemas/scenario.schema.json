{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "type": "object",
  "required": [
    "name",
    "version",
    "range_template",
    "timeline",
    "objectives"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "range_template": {
      "type": "string"
    },
    "variables": {
      "description": "Values for {{ name }} placeholders. Every placeholder in an objective query must be defined here.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t"
        ],
        "properties": {
          "t": {
            "type": "string",
            "pattern": "^[0-9]{1,2}:[0-9]{2}$"
          },
          "action": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "validator",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "detection",
              "response",
              "deliverable"
            ]
          },
          "validator": {
            "type": "string",
            "enum": [
              "opensearch_query",
              "manual_ack",
              "deliverable_check"
            ]
          },
          "params": {
            "type": "object"
          },
          "points": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}