{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "type": "object",
  "required": [
    "name",
    "version",
    "range_template",
    "timeline",
    "objectives"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "range_template": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t"
        ],
        "properties": {
          "t": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}$"
          },
          "action": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "validator",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "detection",
              "response",
              "deliverable"
            ]
          },
          "validator": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "points": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}