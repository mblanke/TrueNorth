{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Range Template",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "type",
          "count"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "vm",
              "k8s",
              "service"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "egress": {
          "type": "string",
          "enum": [
            "restricted",
            "open",
            "none"
          ]
        },
        "east_west": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "network": {
      "type": "object"
    },
    "greyspace": {
      "description": "Attach a Greyspace simulated internet (ADR 0007). Same fields as the API's GreyspaceBlock.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "corpus_tier": {
          "type": "string",
          "enum": [
            "t0",
            "t1",
            "t2",
            "full"
          ]
        },
        "site_packs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "public_prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "npc_profile": {
          "type": "string",
          "enum": [
            "off",
            "office-day",
            "quiet-night"
          ]
        },
        "threat_infra": {
          "type": "boolean"
        },
        "trust_ca": {
          "type": "boolean"
        }
      }
    }
  }
}