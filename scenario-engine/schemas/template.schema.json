{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Range Template",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "type",
          "count"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "vm",
              "k8s",
              "service"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "egress": {
          "type": "string",
          "enum": [
            "restricted",
            "open",
            "none"
          ]
        },
        "east_west": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "verify_ip": {
            "type": "boolean",
            "description": "false: do not hold this VM's guest addresses to VMware Tools at build time (an image deliberately built without Tools); its planned addresses are recorded unverified. Default: the template's verify_ip, else true."
          }
        }
      }
    },
    "verify_ip": {
      "type": "boolean",
      "description": "Default for every node's verify_ip. false: no node's guest addresses are held to VMware Tools at build time. Default true."
    },
    "network": {
      "type": "object"
    },
    "accounts": {
      "description": "Accounts TrueNorth sets on the range's machines at deploy (ADR 0012 §12). The API also checks that each machine is a node id or name, or an asset role, of this template and that a username appears once per machine (control-plane/api/app/range_credentials/accounts.py).",
      "type": [
        "array",
        "null"
      ],
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine",
          "username",
          "student_visible"
        ],
        "properties": {
          "machine": {
            "type": [
              "string",
              "integer"
            ],
            "description": "A node id or name, or an asset role"
          },
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._@\\\\-]{0,103}$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "generate": {
            "type": "boolean",
            "description": "true: TrueNorth makes the password up, once per range"
          },
          "student_visible": {
            "type": "boolean",
            "description": "Handed to Students taking part in the range"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "user"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "oneOf": [
          {
            "required": [
              "password"
            ],
            "not": {
              "required": [
                "generate"
              ],
              "properties": {
                "generate": {
                  "const": true
                }
              }
            }
          },
          {
            "required": [
              "generate"
            ],
            "properties": {
              "generate": {
                "const": true
              }
            },
            "not": {
              "required": [
                "password"
              ]
            }
          }
        ]
      }
    },
    "greyspace": {
      "description": "Attach a Greyspace simulated internet (ADR 0007). Same fields as the API's GreyspaceBlock.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "corpus_tier": {
          "type": "string",
          "enum": [
            "t0",
            "t1",
            "t2",
            "full"
          ]
        },
        "site_packs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "public_prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "npc_profile": {
          "type": "string",
          "enum": [
            "off",
            "office-day",
            "quiet-night"
          ]
        },
        "threat_infra": {
          "type": "boolean"
        },
        "trust_ca": {
          "type": "boolean"
        },
        "network": {
          "description": "The template network (VLAN name) the gs-core VM joins on vSphere; its gateway router routes the zones to Greyspace.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,63}$"
        }
      }
    }
  }
}