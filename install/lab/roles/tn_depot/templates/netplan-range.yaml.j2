# {{ ansible_managed }}
# TN-DEPOT01 range uplink NIC (#214): matched by its MAC and renamed {{ tn_depot_range_if }}, which
# is the name the firewall (table inet tn_depot_range) matches. On-link only: no gateway,
# no DNS, no DHCP, no IPv6; range firewall WANs are on {{ tn_depot_range_subnet }}.
# activation-mode manual: systemd-networkd never brings the link up. Only
# tn-depot-range-link.service does, after the firewall unit and a check of the live table.
network:
  version: 2
  ethernets:
    {{ tn_depot_range_if }}:
      match:
        macaddress: "{{ tn_depot_range_hwaddr | lower }}"
      set-name: {{ tn_depot_range_if }}
      activation-mode: manual
      dhcp4: false
      dhcp6: false
      accept-ra: false
      link-local: []
      addresses: ["{{ tn_depot_range_ip }}/{{ tn_depot_range_prefix }}"]
