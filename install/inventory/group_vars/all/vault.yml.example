---
# TrueNorth Range — secrets template.
#
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
#
# vault.yml is gitignored. Never commit the decrypted file.
#
# Values left empty here are GENERATED ON THE TARGET on first run and persisted
# under {{ tn_config_dir }}/secrets/. They are deliberately not generated on the
# control node, so they never touch your laptop. Re-running the installer reuses
# them — regenerating POSTGRES_PASSWORD on run #2 would lock you out of your own
# database.

# ── Active Directory bind account (created on TN-DC01) ────────────────
vault_ldap_bind_password: "CHANGE_ME"

# ── vCenter service account ───────────────────────────────────────────
vault_vsphere_password: "CHANGE_ME"

# ── Keycloak admin (bootstrap only; not an end-user account) ───────────
vault_keycloak_admin_user: admin
vault_keycloak_admin_password: "CHANGE_ME"

# ── Datastores ────────────────────────────────────────────────────────
vault_postgres_user: forge
vault_postgres_db: forge
vault_postgres_password: "" # generated on target if empty
vault_keycloak_db_password: "" # generated on target if empty
vault_lrs_db_password: "" # generated on target if empty
vault_redis_password: "" # generated on target if empty
vault_minio_access_key: truenorth
vault_minio_secret_key: "" # generated on target if empty

# ── Application secrets ───────────────────────────────────────────────
vault_jwt_secret: "" # generated on target if empty
vault_csrf_secret: "" # generated on target if empty
vault_keycloak_api_client_secret: "" # generated on target if empty
# Seals stored hypervisor/AI credentials. >= 32 random chars; never change it once set
# (to rotate, set "new,old" and restart). Back it up with the database.
vault_secrets_key: "" # generated on target if empty
vault_lrs_admin_user: lrsadmin
vault_lrs_admin_password: "" # generated on target if empty
vault_lrs_api_key: "" # generated on target if empty
vault_lrs_api_secret: "" # generated on target if empty

# ── Monitoring / ops UIs ──────────────────────────────────────────────
vault_grafana_admin_user: admin
vault_grafana_admin_password: "" # generated on target if empty
vault_flower_user: admin
vault_flower_password: "" # generated on target if empty
vault_ai_service_token: "" # generated on target if empty (>= 32 chars)
vault_metrics_scrape_token: "" # generated on target if empty
vault_opensearch_admin_password: "" # generated on target if empty
vault_opensearch_dashboards_password: "" # generated on target if empty
# Where Alertmanager sends alerts (any receiver of Alertmanager's webhook JSON). EMPTY
# MEANS ALERTS GO NOWHERE: the null receiver (install/README.md "Alerting").
vault_alertmanager_webhook_url: ""

# ── Release images (only if the GHCR packages are private) ────────────
# A read:packages token for ghcr.io; leave empty for public images.
vault_ghcr_username: ""
vault_ghcr_token: ""

# ── AI backend ────────────────────────────────────────────────────────
# The LiteLLM master key. Empty is acceptable if the endpoint is unauthenticated
# on a closed network.
vault_openai_api_key: ""
