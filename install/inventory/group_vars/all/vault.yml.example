---
# TrueNorth Range — secrets template.
#
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
#
# vault.yml is gitignored. Never commit the decrypted file.
#
# Values left empty here are GENERATED ON THE TARGET on first run and persisted
# under {{ tn_config_dir }}/secrets/. They are deliberately not generated on the
# control node, so they never touch your laptop. Re-running the installer reuses
# them — regenerating POSTGRES_PASSWORD on run #2 would lock you out of your own
# database. Values you DO set are persisted there too (so backups escrow them), and
# preflight refuses any value still reading CHANGE_ME.
#
# Changing a value after the first install: the datastore and identity passwords
# (postgres, keycloak/lrs DB, Keycloak admin, OpenSearch, Grafana admin) are read only
# when their service first starts, so the installer REFUSES a vault value that differs
# from the persisted one. Rotate them with playbooks/rotate-secret.yml
# (docs/runbooks/key-rotation.md).

# ── Active Directory bind account (created on TN-DC01) ────────────────
# Only with tn_ldap_enabled (the TN lab).
vault_ldap_bind_password: "CHANGE_ME"

# ── vCenter service account ───────────────────────────────────────────
vault_vsphere_password: "CHANGE_ME"

# ── DEPRECATED: range machines' generic password (ADR 0012) ───────────
# Use vault_template_windows_admin_password below. This is used only while that is empty.
# Given to a Windows range VM's Administrator when its range template declares no
# Administrator account (Linux VMs keep the template's generic build password). Empty: a random password per VM that
# nobody is told (the behaviour before ADR 0012). Not generated on target. Document it
# in the wiki for staff; Students get only the accounts a template hands to them.
# Windows complexity applies (upper, lower, digit, symbol; 8+ characters); no single
# quote ('), no newline.
vault_range_default_password: ""

# ── Golden templates' build login (ADR 0012 §5) ───────────────────────
# The passwords the templates were built with: Packer's lab.auto.pkrvars.hcl
# windows_admin_password and ssh_password (user: tn_template_linux_user, default ubuntu).
# Shown to staff only, as the "template default" login of machines with no declared
# account. The Windows one is also what Sysprep sets on those machines (Windows complexity
# applies). Not generated on target; empty: Windows random per VM, Linux "not configured".
# No single quote or newline.
vault_template_windows_admin_password: ""
vault_template_linux_password: ""

# ── SharePoint product key (optional) ─────────────────────────────────
# The key (XXXXX-XXXXX-XXXXX-XXXXX-XXXXX), from the Visual Studio subscription, for the
# SharePoint VERSION the site's ranges use: currently SharePoint Server 2019 (Large
# Enterprise, image srv2022-sharepoint2019). One key for one version: a key for the other
# version (SE) fails SharePoint setup (status 13). The worker installs SharePoint at deploy
# (vmware-site-runbook.md §7.3). Never in a template (ADR 0012 decision 3), never logged.
# Empty: SharePoint stays staged and the role is reported "staged (no product key)".
vault_sharepoint_product_key: ""

# Optional NVD API key for the content feeds' daily pull (tn_feeds_mode: online). Without
# one the pull keeps to NVD's public rate limit. Worker only, sent as a header, never logged.
vault_feeds_nvd_api_key: ""

# ── Keycloak admin (bootstrap only; not an end-user account) ───────────
# The master-realm admin. Only the installer uses it; the API has its own
# least-privilege service account (truenorth-api-admin).
vault_keycloak_admin_user: admin
vault_keycloak_admin_password: "" # generated on target if empty
# Without AD (tn_ldap_enabled false): the local bootstrap administrator's password.
vault_bootstrap_admin_password: "" # generated on target if empty

# ── Datastores ────────────────────────────────────────────────────────
vault_postgres_user: forge
vault_postgres_db: forge
vault_postgres_password: "" # generated on target if empty
vault_keycloak_db_password: "" # generated on target if empty
vault_lrs_db_password: "" # generated on target if empty
vault_redis_password: "" # generated on target if empty
vault_minio_access_key: truenorth
vault_minio_secret_key: "" # generated on target if empty

# ── Application secrets ───────────────────────────────────────────────
vault_jwt_secret: "" # generated on target if empty
vault_csrf_secret: "" # generated on target if empty
vault_keycloak_api_client_secret: "" # generated on target if empty
vault_keycloak_api_admin_client_secret: "" # generated on target if empty
# Seals stored hypervisor/AI credentials. >= 32 random chars; never change it once set
# (to rotate, set "new,old" and restart). Back it up with the database.
vault_secrets_key: "" # generated on target if empty
vault_lrs_admin_user: lrsadmin
vault_lrs_admin_password: "" # generated on target if empty
vault_lrs_api_key: "" # generated on target if empty
vault_lrs_api_secret: "" # generated on target if empty
# cmi5 AU traffic's own LRS credential (CMI5_LRS_AUTH, base64 "key:secret"; docs/cmi5.md).
# Empty: 50-stack-up mints one on the LRS once and keeps it. Set: it must already be a
# credential of this LRS with exactly the AU scopes, and differ from the LRS_API_* one.
vault_cmi5_lrs_auth: "" # minted on the LRS if empty

# ── Monitoring / ops UIs ──────────────────────────────────────────────
vault_grafana_admin_user: admin
vault_grafana_admin_password: "" # generated on target if empty
vault_flower_user: admin
vault_flower_password: "" # generated on target if empty
vault_ai_service_token: "" # generated on target if empty (>= 32 chars)
vault_metrics_scrape_token: "" # generated on target if empty
vault_opensearch_admin_password: "" # generated on target if empty
vault_opensearch_dashboards_password: "" # generated on target if empty
# Where Alertmanager sends alerts (any receiver of Alertmanager's webhook JSON). EMPTY
# MEANS ALERTS GO NOWHERE: the null receiver (install/README.md "Alerting").
vault_alertmanager_webhook_url: ""

# ── Alert email (only with tn_alert_email_enabled) ────────────────────
# The SMTP account Alertmanager signs in to at tn_alert_smtp_host. Preflight refuses
# CHANGE_ME while alert email is on; set both, or empty both for a relay that accepts
# unauthenticated mail from this host. The password reaches only a 0600 file Alertmanager
# reads (smtp_auth_password_file), never its config or the environment.
vault_alert_smtp_username: "CHANGE_ME"
vault_alert_smtp_password: "CHANGE_ME"

# ── Moodle (only with tn_moodle_enabled) ──────────────────────────────
# 32+ characters of A-Z a-z 0-9 . _ - ; generated on target if empty.
vault_moodle_db_password: ""
vault_moodle_admin_password: ""

# ── Release images (only if the GHCR packages are private) ────────────
# A read:packages token for ghcr.io; leave empty for public images.
vault_ghcr_username: ""
vault_ghcr_token: ""

# ── AI backend ────────────────────────────────────────────────────────
# The LiteLLM master key. Empty is acceptable if the endpoint is unauthenticated
# on a closed network.
vault_openai_api_key: ""

# ── ARC² Course Studio (only with tn_arc2_enabled) ────────────────────
# The course-authoring runner's model credential. When ARC² is on, set EXACTLY ONE of the
# two below: there is no default, and preflight stops with neither or both (so it is never
# ambiguous which account is billed). Whichever is set reaches only the runner (a root 0600
# systemd EnvironmentFile), never a command line or the stack's env file. Each job can read
# it, and can reach only the model endpoint with it.
#
# Claude subscription (recommended if you already have one): run `claude setup-token` on
# any machine signed in to the subscription and paste the token (sk-ant-oat...) here. It is
# the operator's own credential: usage counts against that subscription's limits. A job that
# hits a limit stops with Claude Code's usage-limit message and is not retried (the local-model
# fallback stays off on the platform host); send it again once the limit resets. The token
# is long-lived: revoke it and issue a new one if this host is rebuilt or decommissioned.
vault_arc2_claude_oauth_token: ""
# Or a pay-per-use Anthropic API key (sk-ant-api...), billed per token. Issue it for this
# host alone, with a spending limit.
vault_arc2_anthropic_api_key: ""
# With tn_arc2_mode local (leave both above empty), subscription_with_local_fallback or
# local_with_subscription_fallback (plus one of the above): the bearer token of the gateway at tn_arc2_local_url, for example a
# LiteLLM virtual key issued for this host alone. It reaches only the runner's 0600
# EnvironmentFile (as ARC2_LOCAL_TOKEN), and each job only as Claude Code's own setting.
vault_arc2_local_token: ""
