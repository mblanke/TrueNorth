# ═══════════════════════════════════════════════════════════════════════
# TrueNorth Range — Moodle node {{ tn_moodle_node }} (compose.moodle-prod.yml)
#
# GENERATED by install/roles/tn_moodle. Do not edit by hand: the next run overwrites it.
# Change install/inventory/group_vars instead. Outside the checkout, mode 0600: it holds
# the Moodle database and administrator passwords (both also in config/secrets/).
# ═══════════════════════════════════════════════════════════════════════
MOODLE_NODE={{ tn_moodle_node }}
TN_IMAGE_MOODLE={{ tn_moodle_image_ref }}
TN_DATA_ROOT={{ tn_data_root }}
SSL_CERT_PATH={{ tn_tls_dir }}

# Its database in the platform's PostgreSQL (postgres:5432 on tn-backend).
MOODLE_DB_NAME={{ tn_moodle_db_name }}
MOODLE_DB_USER={{ tn_moodle_db_user }}
MOODLE_DB_PASSWORD={{ tn_moodle_creds['moodle_db_password'] }}

# The `admin` account (break-glass: /login/index.php?loginredirect=0).
MOODLE_ADMIN_PASSWORD={{ tn_moodle_creds['moodle_admin_password'] }}
MOODLE_ADMIN_EMAIL={{ tn_moodle_admin_email }}
MOODLE_SITENAME={{ tn_moodle_sitename }}

# Where browsers reach it, through moodle-edge.
MOODLE_SITE_URL={{ tn_moodle_site_url }}
MOODLE_PUBLIC_PORT={{ tn_moodle_port }}
MOODLE_SMTP_HOST={{ tn_moodle_smtp_host }}
MOODLE_SMTP_PORT={{ tn_moodle_smtp_port }}

# TrueNorth: the API browsers reach, the app Moodle's login page sends people to, and the
# tenant whose tickets this node accepts (and no other's).
TN_TOOL_URL={{ tn_moodle_tool_url }}
TN_LOGIN_URL={{ tn_moodle_login_url }}
TN_TENANT_ID={{ tn_moodle_tenant_id }}
