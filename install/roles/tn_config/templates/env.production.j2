# ═══════════════════════════════════════════════════════════════════════
# TrueNorth Range — production environment
#
# GENERATED by install/roles/tn_config. Do not edit by hand: the next
# ansible-playbook run overwrites it. Change the values in
# install/inventory/group_vars/all/{main,vault}.yml instead.
#
# Deliberately outside the git checkout, so no secret can be swept into a commit
# (infra/platform/docker/.env.production was once tracked; it is now git-ignored).
# ═══════════════════════════════════════════════════════════════════════

# ── Identity of this deployment ───────────────────────────────────────
DOMAIN={{ tn_domain_fqdn }}
TN_DATA_ROOT={{ tn_data_root }}
SSL_CERT_PATH={{ tn_tls_dir }}
TRUSTSTORE_PATH={{ tn_tls_dir }}/truststores
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER={{ vault_postgres_user | default('forge') }}
POSTGRES_DB={{ vault_postgres_db | default('forge') }}
POSTGRES_PASSWORD={{ tn_secrets['postgres_password'] }}

# Keycloak and the LRS get their OWN databases. Sharing POSTGRES_DB puts ~90
# Keycloak tables beside the application's 68, and `alembic autogenerate` then
# proposes dropping all of them.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD={{ tn_secrets['keycloak_db_password'] }}
LRS_DB=lrs
LRS_DB_USER=lrs
LRS_DB_PASSWORD={{ tn_secrets['lrs_db_password'] }}

# Alembic owns the schema in production. Without these the API lifespan runs
# create_all() and a dev seed on every start, across all four uvicorn workers,
# racing migrations and minting a hardcoded admin@truenorth.local.
DB_AUTO_CREATE=false
SEED_DEV_DATA=false

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PASSWORD={{ tn_secrets['redis_password'] }}
REDIS_MAXMEMORY=2gb

# ── Object storage ────────────────────────────────────────────────────
MINIO_ACCESS_KEY={{ vault_minio_access_key | default('truenorth') }}
MINIO_SECRET_KEY={{ tn_secrets['minio_secret_key'] }}

# ── Search / telemetry ────────────────────────────────────────────────
OPENSEARCH_HEAP=4g
# Security plugin on (install/README.md, "OpenSearch"): TLS from the internal CA
# roles/tn_tls makes, basic auth with the passwords generated above.
{% if tn_opensearch_disable_security | bool %}
# LAB/DEV OVERRIDE (tn_opensearch_disable_security): no auth, plain http.
OPENSEARCH_DISABLE_SECURITY=true
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=
{% else %}
OPENSEARCH_DISABLE_SECURITY=false
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USER=admin
{% endif %}
OPENSEARCH_PASS={{ tn_secrets['opensearch_admin_password'] }}
OPENSEARCH_DASHBOARDS_PASS={{ tn_secrets['opensearch_dashboards_password'] }}
OPENSEARCH_VERIFY_SSL=/etc/truenorth/opensearch-ca.pem
OPENSEARCH_CERTS_DIR={{ tn_opensearch_certs_dir }}
OPENSEARCH_INTERNAL_USERS={{ tn_opensearch_internal_users }}
SEARCH_BACKEND=opensearch

# ── Authentication ────────────────────────────────────────────────────
KEYCLOAK_REALM={{ tn_keycloak_realm }}
KEYCLOAK_ADMIN_USER={{ vault_keycloak_admin_user | default('admin') }}
KEYCLOAK_ADMIN_PASSWORD={{ vault_keycloak_admin_password }}
KEYCLOAK_ADMIN_PORT={{ tn_keycloak_admin_port }}
# Tokens must come from this realm on this host.
KEYCLOAK_ISSUER={{ tn_keycloak_issuer }}
AUTH_DISABLED=false
JWT_SECRET={{ tn_secrets['jwt_secret'] }}
CSRF_SECRET={{ tn_secrets['csrf_secret'] }}
# Seals stored hypervisor passwords and AI engine keys (app/secretbox.py). Losing this key
# loses every stored credential; back it up with the database.
TN_SECRETS_KEY={{ tn_secrets['secrets_key'] }}

# Set by roles/tn_keycloak once the LDAP federation component exists. The
# /ad-sync endpoints call Keycloak's sync API with this id.
KEYCLOAK_LDAP_COMPONENT_ID={{ tn_keycloak_ldap_component_id | default('') }}

# ── Active Directory ──────────────────────────────────────────────────
LDAP_SERVER={{ tn_dc_host }}
LDAP_PORT={{ tn_ldap_port }}
LDAP_BASE_DN={{ tn_ldap_base_dn }}
LDAP_BIND_DN={{ tn_ldap_bind_dn }}

# ── LTI 1.3 ───────────────────────────────────────────────────────────
LTI_TOOL_BASE_URL=https://{{ tn_domain_fqdn }}/api
LTI_WEB_BASE_URL=https://{{ tn_domain_fqdn }}

# ── Trainee registration & onboarding ─────────────────────────────────
# Groups gate eligibility to REGISTER and pre-fill the approver's screen. They
# never grant a role on their own — approval does that.
REGISTRATION_ALLOWED_GROUPS={{ tn_registration_allowed_groups }}
REGISTRATION_GROUP_ROLE_MAP={{ tn_registration_group_role_map | to_json }}
REGISTRATION_DEFAULT_TENANT_SLUG={{ tn_tenant_slug }}
REGISTRATION_DEFAULT_PROGRESSION={{ tn_default_progression }}

# ── Learning record store (xAPI) ──────────────────────────────────────
LMS_BACKEND=xapi_lrs
LRS_URL=http://lrs:8080
LRS_ADMIN_USER={{ vault_lrs_admin_user | default('lrsadmin') }}
LRS_ADMIN_PASSWORD={{ tn_secrets['lrs_admin_password'] }}
LRS_API_KEY={{ tn_secrets['lrs_api_key'] }}
LRS_API_SECRET={{ tn_secrets['lrs_api_secret'] }}
LRS_AUTH={{ tn_lrs_auth }}

# ── Provisioner ───────────────────────────────────────────────────────
# Registry keys (worker/provisioners/__init__.py): mock | proxmox_api |
# vsphere_api | hyperv | terraform | terraform_{proxmox,vsphere,hyperv}.
# Bare "vsphere" and "proxmox" are NOT keys and raise ValueError at first use.
PROVISIONER_BACKEND={{ tn_provisioner_backend }}
VSPHERE_URL=https://{{ tn_vcenter_host }}
VSPHERE_USERNAME={{ tn_vcenter_user }}
VSPHERE_PASSWORD={{ vault_vsphere_password }}
VSPHERE_DATACENTER={{ tn_vsphere_datacenter }}
VSPHERE_CLUSTER={{ tn_vsphere_cluster }}
VSPHERE_DATASTORE={{ tn_vsphere_datastore }}
VSPHERE_NETWORK={{ tn_vsphere_network }}
VSPHERE_MGMT_NETWORK={{ tn_vsphere_mgmt_network }}
VSPHERE_VERIFY_SSL={{ tn_vsphere_verify_ssl | lower }}
VSPHERE_CONTENT_LIBRARY={{ tn_vsphere_content_library }}
VSPHERE_CONCURRENCY={{ tn_vsphere_concurrency }}
VSPHERE_TOOLS_TIMEOUT={{ tn_vsphere_tools_timeout }}
VSPHERE_SNAPSHOT_TIMEOUT={{ tn_vsphere_snapshot_timeout }}
VSPHERE_RANGE_SWITCH_MODE={{ tn_vsphere_range_switch_mode }}
VSPHERE_RANGE_DVS={{ tn_vsphere_range_dvs }}
VSPHERE_RANGE_VSWITCH={{ tn_vsphere_range_vswitch }}
VSPHERE_VLAN_POOL={{ tn_vsphere_vlan_pool }}
VSPHERE_PLACEMENT={{ tn_vsphere_placement }}
VSPHERE_RANGE_FOLDER={{ tn_vsphere_range_folder }}
VSPHERE_MAX_VCPU_PER_THREAD={{ tn_vsphere_max_vcpu_per_thread }}
VSPHERE_EXCLUDE_HOSTS={{ tn_vsphere_exclude_hosts | join(',') }}
VSPHERE_RANGE_UPLINK_NETWORK={{ tn_vsphere_range_uplink_network }}
VSPHERE_RANGE_UPLINK_POOL={{ tn_vsphere_range_uplink_pool }}
VSPHERE_RANGE_UPLINK_GATEWAY={{ tn_vsphere_range_uplink_gateway }}
VSPHERE_RANGE_UPLINK_PREFIX={{ tn_vsphere_range_uplink_prefix }}
VSPHERE_PROVISION_BUDGET={{ tn_vsphere_provision_budget }}
TN_DEPOT_URL={{ tn_depot_url }}
TN_DEPOT_CHOCO_FEED={{ tn_depot_choco_feed }}
TN_DEPOT_APT_PROXY={{ tn_depot_apt_proxy }}
TN_SOFTWARE_INSTALL_TIMEOUT={{ tn_software_install_timeout }}

# Proxmox is not in use on this platform; the keys exist because compose
# interpolates them.
PROXMOX_API_URL=
PROXMOX_TOKEN=

# ── AI orchestrator ───────────────────────────────────────────────────
AI_MODEL_BACKEND=openai
OPENAI_BASE_URL={{ tn_ai_base_url }}
OPENAI_API_KEY={{ vault_openai_api_key | default('') }}
ANTHROPIC_API_KEY=
MAX_LLM_CONCURRENCY=20

# ── Ops UIs ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER={{ vault_grafana_admin_user | default('admin') }}
GRAFANA_ADMIN_PASSWORD={{ tn_secrets['grafana_admin_password'] }}
FLOWER_USER={{ vault_flower_user | default('admin') }}
FLOWER_PASSWORD={{ tn_secrets['flower_password'] }}
