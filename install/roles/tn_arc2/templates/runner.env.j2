# {{ ansible_managed }} (install/roles/tn_arc2). root:root 0600.
# Read by systemd for {{ tn_arc2_service }} (EnvironmentFile); never on a command line, never in
# the stack's .env.production. The runner hands it to each job's sandbox, whose only way
# out is the egress proxy to {{ tn_arc2_egress_allow }}: use credentials for this host only.
# What is here follows tn_arc2_mode ({{ tn_arc2_mode | default('subscription') }}): subscription, exactly one Anthropic
# credential; local, the gateway's token alone; subscription_with_local_fallback, both.
# Preflight and 55-arc2 refuse anything else, so it is never ambiguous which account is billed.
{% if tn_arc2_mode | default('subscription') != 'local' %}
{% if vault_arc2_claude_oauth_token | default('') | string | trim | length > 0 %}
# The operator's Claude subscription (`claude setup-token`); usage counts against its limits.
CLAUDE_CODE_OAUTH_TOKEN={{ vault_arc2_claude_oauth_token | string | trim }}
{% else %}
# A pay-per-use Anthropic API key.
ANTHROPIC_API_KEY={{ vault_arc2_anthropic_api_key | string | trim }}
{% endif %}
{% endif %}
{% if tn_arc2_mode | default('subscription') != 'subscription' %}
# The local gateway's bearer token ({{ tn_arc2_local_url }}).
ARC2_LOCAL_TOKEN={{ vault_arc2_local_token | string | trim }}
{% endif %}
