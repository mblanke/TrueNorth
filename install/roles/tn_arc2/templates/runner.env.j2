# {{ ansible_managed }} (install/roles/tn_arc2). root:root 0600.
# Read by systemd for {{ tn_arc2_service }} (EnvironmentFile); never on a command line, never in
# the stack's .env.production. The runner hands it to each job's sandbox, whose only way
# out is the egress proxy to {{ tn_arc2_egress_allow }}: use a credential for this host only.
# Exactly one of the two vault variables is set (preflight and 55-arc2 refuse both or
# neither), so it is never ambiguous which account is billed.
{% if vault_arc2_claude_oauth_token | default('') | string | trim | length > 0 %}
# The operator's Claude subscription (`claude setup-token`); usage counts against its limits.
CLAUDE_CODE_OAUTH_TOKEN={{ vault_arc2_claude_oauth_token | string | trim }}
{% else %}
# A pay-per-use Anthropic API key.
ANTHROPIC_API_KEY={{ vault_arc2_anthropic_api_key | string | trim }}
{% endif %}
