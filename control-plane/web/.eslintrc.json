{
  "root": true,
  "ignorePatterns": [
    "projects/**/*"
  ],
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "rules": {
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "tn",
            "style": "camelCase"
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "tn",
            "style": "kebab-case"
          }
        ],
        // Added to recommended in angular-eslint 20. Constructor injection is still
        // supported; convert with `ng generate @angular/core:inject`, then drop this.
        "@angular-eslint/prefer-inject": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
      }
    },
    {
      "files": [
        "*.html"
      ],
      "extends": [
        "plugin:@angular-eslint/template/recommended",
        "plugin:@angular-eslint/template/accessibility"
      ],
      "rules": {
        // Added to recommended in angular-eslint 21. *ngIf/*ngFor still work; convert
        // with `ng generate @angular/core:control-flow`, then drop this.
        "@angular-eslint/template/prefer-control-flow": "off"
      }
    }
  ]
}
