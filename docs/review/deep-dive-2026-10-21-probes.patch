+def test_review_expired_ip_check_settles_when_vcenter_unreachable(ip_world, world, monkeypatch):
+    import worker.tasks as tasks
+    ip_world["vms"][0]["ip_check"]["deadline"] = time.time() - 600
+    def offline(*args, **kwargs):
+        raise ConnectionError("review fixture: vCenter unavailable")
+    monkeypatch.setattr(tasks, "_get_backend", offline)
+    sr._reconcile_range("r1", "Range 1", ip_world, "vsphere")
+    assert world["written"] is not None, "Expired IP check is never settled during a vCenter outage"
