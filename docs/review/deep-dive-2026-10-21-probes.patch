+@pytest.mark.parametrize("detail", [False, True])
+def test_review_foreign_qualification_is_hidden(client, db_session, detail):
+    po = _po(db_session)
+    qual = db_session.get(Qualification, po.qualification_id)
+    qual.tenant_id = uuid.UUID(OTHER_TENANT)
+    db_session.commit()
+    with acting_as(UserRole.student):
+        path = f"/qsp/qualifications/{qual.qsp_code}/objectives" if detail else "/qsp/qualifications"
+        response = client.get(path)
+        if detail:
+            assert response.status_code == 404
+        else:
+            assert qual.qsp_code not in [q["qsp_code"] for q in response.json()]
+
