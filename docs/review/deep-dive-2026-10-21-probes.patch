+def test_review_shared_objective_hides_other_tenant_course(client, db_session):
+    from app.models import Course, CourseModule, ModuleContentType
+    po = _po(db_session)
+    course = Course(name="Private tenant B course", tenant_id=uuid.UUID(OTHER_TENANT))
+    db_session.add(course)
+    db_session.flush()
+    db_session.add(CourseModule(course_id=course.id, po_id=po.id, ordinal=1, title="Private module", content_type=ModuleContentType.scenario))
+    db_session.commit()
+    with acting_as(UserRole.student):
+        response = client.get("/qsp/qualifications/ALJQ/objectives")
+        assert response.status_code == 200
+        assert response.json()[0]["delivered_by"] is None, response.json()[0]["delivered_by"]
