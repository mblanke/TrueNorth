# Copy to .env, replace every placeholder value (see runbook Step 1), then: chmod 600 .env
# Never commit .env.
LRS_KEY=REPLACE_ME
LRS_SECRET=REPLACE_ME
LRS_ADMIN_USER=lrsadmin
LRS_ADMIN_PASS=REPLACE_ME
PG_PASSWORD=REPLACE_ME
# Comma-separated origins allowed to call the LRS from a browser (for au/cmi5-au-minimal.html testing)
LRS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
