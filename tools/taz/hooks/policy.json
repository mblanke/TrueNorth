{
  "_comment": "Default policy for tools/taz/hooks (write_gate.py, scripts/taz_guard.py). Owner rule: no Chinese models except GLM. Bakeoff and production model names are added to write_allowlist per deployment, in the deployed copy of this file, never here. List the name the backend reports (the served model in the transcript), not only the LiteLLM alias. See tools/taz/README.md.",
  "write_allowlist": ["claude-"],
  "rings": {
    "capability": true,
    "whole_file": true,
    "amnesia": true,
    "card": true,
    "protected": true,
    "bash": true
  },
  "whole_file_max_lines": 150,
  "exempt_roots": ["~/.claude/plans"],
  "mutating_tools": ["Write", "Edit", "MultiEdit", "NotebookEdit"],
  "unguarded_suffixes": [".md", ".markdown", ".txt", ".rst", ".adoc", ".org",
                         ".csv", ".tsv", ".log", ".patch", ".diff"],
  "extra_code_suffixes": [],
  "extra_code_names": [],
  "protected_paths": [
    ".dod-*baseline",
    "**/.dod-*baseline",
    ".git/**",
    "**/.git",
    "**/.git/**",
    ".github/**",
    ".claude/**",
    ".agents/**",
    "tools/taz/hooks/**",
    "tools/taz/courses/**",
    "scripts/check_course.py",
    "docs/interfaces/course-content.schema.json",
    "docs/interfaces/course-instructor-pack.schema.json",
    "scripts/taz_guard.py",
    "scripts/dod.sh",
    "scripts/ruff-gate.sh",
    "scripts/mosa_check.py",
    "scripts/export_*.py",
    "control-plane/web/scripts/**",
    "pyproject.toml",
    "pytest.ini",
    "setup.cfg",
    "**/conftest.py",
    "**/.npmrc",
    "**/.yarnrc*",
    "**/.pnpmfile*",
    "**/karma.conf.js",
    "**/eslint.config.*",
    "**/.eslintrc*",
    "**/tsconfig*.json",
    "**/package.json",
    "**/angular.json",
    "**/alembic/versions/**",
    "control-plane/api/app/auth.py",
    "control-plane/api/app/auth_*.py",
    "control-plane/api/app/auth_backends/**",
    "control-plane/api/app/ws_auth.py",
    "**/rbac.py",
    "**/rbac/**",
    "**/tenancy.py",
    "**/tenancy/**",
    "control-plane/web/src/app/core/auth/**",
    "control-plane/web/src/app/core/guards/**",
    "control-plane/web/src/app/core/interceptors/**",
    "**/provisioners/**",
    "**/result_transfer/**",
    "**/classes/onboarding.py",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/uv.lock",
    "**/poetry.lock",
    "**/Pipfile.lock",
    "**/Cargo.lock",
    "**/go.sum",
    "**/*.lock",
    "**/.terraform.lock.hcl"
  ],
  "lockfile_globs": [
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/uv.lock",
    "**/poetry.lock",
    "**/Pipfile.lock",
    "**/Cargo.lock",
    "**/go.sum",
    "**/*.lock",
    "**/.terraform.lock.hcl"
  ],
  "bash": {
    "extra_readonly_commands": [],
    "allowed_scripts": ["scripts/dod.sh", "scripts/export_openapi.py", "scripts/check_course.py"],
    "npm_scripts": ["test", "gen:api"],
    "safe_env": ["CHROME_BIN", "DOD_WEB", "CI", "NO_COLOR", "FORCE_COLOR", "TZ", "LANG",
                 "LC_ALL", "COLUMNS", "PYTHONDONTWRITEBYTECODE"]
  },
  "log_path": null
}
