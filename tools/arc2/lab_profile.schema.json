{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARC2 lab profile",
  "description": "The small individual range a range activity needs: what to build, how to know it is ready, what the student may reach, what evidence is collected, and how it is reset and expired. Written by the range-engineer to 03-range/lab_profile.yaml; the platform provisions one copy per student attempt. Image references are catalogue ids, never hypervisor template names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "objective", "module_ids", "nodes", "networks", "health_checks", "access", "evidence_checks", "limits", "reset", "lifetime", "egress"],
  "definitions": {
    "nonempty": {"type": "string", "minLength": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$"},
    "module_id": {"type": "string", "pattern": "^mod_[0-9]{3}$"}
  },
  "properties": {
    "schema_version": {"const": "arc2/lab-profile/0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": "integer", "minimum": 1},
    "objective": {"$ref": "#/definitions/nonempty"},
    "module_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/module_id"}},
    "justification": {"$ref": "#/definitions/nonempty"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "catalogue_id", "vcpu", "ram_mb", "disk_gb", "networks"],
        "properties": {
          "name": {"$ref": "#/definitions/name"},
          "catalogue_id": {"$ref": "#/definitions/nonempty"},
          "role": {"type": "string"},
          "vcpu": {"type": "integer", "minimum": 1, "maximum": 16},
          "ram_mb": {"type": "integer", "minimum": 256, "maximum": 65536},
          "disk_gb": {"type": "integer", "minimum": 1, "maximum": 500},
          "networks": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/name"}},
          "configuration": {"type": "array", "items": {"$ref": "#/definitions/nonempty"}}
        }
      }
    },
    "networks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"$ref": "#/definitions/name"},
          "cidr": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"}
        }
      }
    },
    "health_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "kind", "timeout_s"],
        "properties": {
          "node": {"$ref": "#/definitions/name"},
          "kind": {"enum": ["tools", "tcp", "ssh", "http"]},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "path": {"type": "string"},
          "timeout_s": {"type": "integer", "minimum": 5, "maximum": 1800}
        }
      }
    },
    "access": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "kind"],
        "properties": {
          "node": {"$ref": "#/definitions/name"},
          "kind": {"enum": ["console"]}
        }
      }
    },
    "evidence_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "node", "description"],
        "properties": {
          "id": {"$ref": "#/definitions/name"},
          "node": {"$ref": "#/definitions/name"},
          "description": {"$ref": "#/definitions/nonempty"},
          "validator_id": {"$ref": "#/definitions/nonempty"}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_vms", "vcpu_total", "ram_mb_total", "disk_gb_total"],
      "properties": {
        "max_vms": {"type": "integer", "minimum": 1, "maximum": 64},
        "vcpu_total": {"type": "integer", "minimum": 1},
        "ram_mb_total": {"type": "integer", "minimum": 256},
        "disk_gb_total": {"type": "integer", "minimum": 1}
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"enum": ["snapshot", "rebuild"]}}
    },
    "lifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idle_minutes", "max_minutes"],
      "properties": {
        "idle_minutes": {"type": "integer", "minimum": 5, "maximum": 1440},
        "max_minutes": {"type": "integer", "minimum": 15, "maximum": 10080}
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"enum": ["none", "allowlist"]},
        "allow": {"type": "array", "items": {"$ref": "#/definitions/nonempty"}}
      }
    }
  }
}
