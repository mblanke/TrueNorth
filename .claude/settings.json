{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --git-common-dir 2>/dev/null)/../.coord/coord.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" guard",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --git-common-dir 2>/dev/null)/../.coord/coord.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" session-start || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --git-common-dir 2>/dev/null)/../.coord/coord.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" checkpoint --quiet || true",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
