# -- AI Orchestrator Configuration ------------------------------------------
# Primary backend: ollama | openai | anthropic | mock
AI_MODEL_BACKEND=ollama

# -- Ollama Fleet (dynamic node discovery) ----------------------------------
# Comma-separated list of name=url pairs. Models are auto-discovered
# via health checks and tagged by capability (instruct, code, embedding, etc.).
# Example with three GPU nodes:
#   OLLAMA_NODES=gpu1=http://10.0.0.10:11434,gpu2=http://10.0.0.11:11434,gpu3=http://10.0.0.12:11434
# Leave empty for no local Ollama nodes (cloud-only mode):
OLLAMA_NODES=

OLLAMA_PROXY_URL=https://ai.guapo613.beer

# Per-node concurrency (depends on GPU VRAM / model size)
MAX_OLLAMA_PER_NODE=4
# Global max concurrent LLM calls across all backends
MAX_LLM_CONCURRENCY=20
# Health check interval in seconds
HEALTH_CHECK_INTERVAL=30

# -- Cloud Fallback (optional) ----------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -- Cache -------------------------------------------------------------------
AI_CACHE_TTL=3600
AI_CACHE_MAX=2000

# -- Auth --------------------------------------------------------------------
AUTH_DISABLED=true

# -- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200,http://localhost:3000