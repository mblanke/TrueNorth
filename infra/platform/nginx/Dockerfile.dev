# 1.25-alpine is Alpine 3.19 (end of life). Root master for 80/443, as in Dockerfile.
FROM nginx:1.30-alpine

LABEL maintainer="TrueNorth Range DevOps"
LABEL description="Development reverse proxy for TrueNorth Range platform"

RUN apk add --no-cache openssl \
    && rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/ssl /var/www/certbot /var/cache/nginx \
    && openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
       -keyout /etc/nginx/ssl/truenorth.key \
       -out /etc/nginx/ssl/truenorth.crt \
       -subj "/CN=localhost" \
       -addext "subjectAltName=DNS:localhost,DNS:host.docker.internal,IP:127.0.0.1" \
    && chown -R nginx:nginx /var/cache/nginx

COPY nginx.conf /etc/nginx/nginx.conf
COPY conf.d/ /etc/nginx/conf.d/
COPY snippets/ /etc/nginx/snippets/

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
