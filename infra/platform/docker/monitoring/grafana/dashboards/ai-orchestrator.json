{
  "uid": "truenorth-ai-orchestrator",
  "title": "TrueNorth Range — AI Orchestrator",
  "description": "AI inference fleet, latency, cache, and error metrics",
  "tags": ["truenorth", "ai", "orchestrator"],
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Fleet Node Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false, "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "healthy" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false },
        "sortBy": [{ "displayName": "node", "desc": false }]
      },
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "excludeByName": {}, "indexByName": {}, "renameByName": {} } }
      ],
      "targets": [
        { "refId": "A", "expr": "ai_fleet_node_healthy",                              "legendFormat": "{{ node }}", "format": "table", "instant": true },
        { "refId": "B", "expr": "ai_fleet_node_loaded_models",                        "legendFormat": "{{ node }}", "format": "table", "instant": true },
        { "refId": "C", "expr": "ai_fleet_node_inflight_requests",                    "legendFormat": "{{ node }}", "format": "table", "instant": true }
      ]
    },
    {
      "id": 2,
      "title": "Inference Requests/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "pointSize": 5 },
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_inference_requests_total{job=\"ai-orchestrator\"}[5m]))",
          "legendFormat": "Total req/s"
        },
        {
          "refId": "B",
          "expr": "sum by (backend) (rate(ai_inference_requests_total{job=\"ai-orchestrator\"}[5m]))",
          "legendFormat": "{{ backend }}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Inference Latency P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5 },
          "unit": "s",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(ai_inference_duration_seconds_bucket{job=\"ai-orchestrator\"}[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(ai_inference_duration_seconds_bucket{job=\"ai-orchestrator\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(ai_inference_duration_seconds_bucket{job=\"ai-orchestrator\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests by Task Type",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80 },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "stacking": "none",
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type) (increase(ai_inference_requests_total{job=\"ai-orchestrator\"}[1h]))",
          "legendFormat": "{{ task_type }}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Model Cache Hit Rate",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 85 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_model_cache_hits_total[5m])) / (sum(rate(ai_model_cache_hits_total[5m])) + sum(rate(ai_model_cache_misses_total[5m]))) * 100",
          "legendFormat": "Cache Hit %"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cloud Fallback Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "percentunit",
          "color": { "fixedColor": "orange", "mode": "fixed" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_cloud_fallback_total[5m])) / sum(rate(ai_inference_requests_total[5m]))",
          "legendFormat": "Fallback Rate"
        }
      ]
    },
    {
      "id": 7,
      "title": "Token Usage",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "stacking": { "mode": "normal" } },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_token_usage_total{direction=\"input\"}[5m]))",
          "legendFormat": "Input Tokens/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ai_token_usage_total{direction=\"output\"}[5m]))",
          "legendFormat": "Output Tokens/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Error Rate by Backend",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20 },
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend) (rate(ai_inference_errors_total{job=\"ai-orchestrator\"}[5m]))",
          "legendFormat": "{{ backend }}"
        }
      ]
    }
  ]
}