# ═══════════════════════════════════════════════════════════════════
# TrueNorth Range — Production Environment Configuration
# Copy to .env.production and fill in all CHANGE_ME placeholders
# ═══════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────
# production: the API and AI orchestrator refuse to start with a missing or unsafe
# setting and list every one (control-plane/api/app/settings.py). compose.prod.yml
# defaults to it.
TN_ENV=production
# The deployed build (a tag or commit), reported by /health and the OpenAPI document.
TN_VERSION=

# ─── Application images (deploy by digest) ────────────────────────
# compose.prod.yml builds nothing: it runs these refs. Copy each `ref` (image@sha256) from
# the release's release-manifest.json (docs/release.md); the installer renders them for
# you. Never a tag: a tag can be moved. The release's scenario-engine image is not a
# service here (the api mounts the engine from the app source at the same commit).
# To build from a checkout instead, see compose.build.yml (local tags, never production).
TN_IMAGE_API=ghcr.io/mblanke/truenorth-api@sha256:CHANGE_ME_FROM_RELEASE_MANIFEST
TN_IMAGE_WORKER=ghcr.io/mblanke/truenorth-worker@sha256:CHANGE_ME_FROM_RELEASE_MANIFEST
TN_IMAGE_WEB=ghcr.io/mblanke/truenorth-web@sha256:CHANGE_ME_FROM_RELEASE_MANIFEST
TN_IMAGE_AI_ORCHESTRATOR=ghcr.io/mblanke/truenorth-ai-orchestrator@sha256:CHANGE_ME_FROM_RELEASE_MANIFEST

# ─── Domain & SSL ─────────────────────────────────────────────────
# Fully qualified domain name for the deployment
DOMAIN=CHANGE_ME.example.com
# Path on host to the directory holding the nginx certificate pair.
# The files MUST be named truenorth.crt and truenorth.key — those names are
# hardcoded in nginx/conf.d/truenorth.conf. (This comment used to say
# fullchain.pem/privkey.pem, which nginx never reads.)
SSL_CERT_PATH=/etc/ssl/truenorth

# Directory mounted into Keycloak as its PEM truststore. Must contain the AD CS
# root CA, or LDAPS federation fails with "PKIX path building failed".
TRUSTSTORE_PATH=/srv/truenorth/tls/truststores

# Root of the provisioned data disk. The pg/redis/minio/opensearch volumes bind
# here; leaving it unset puts all state in /var/lib/docker on the OS disk.
TN_DATA_ROOT=/srv/truenorth

# ─── Database (PostgreSQL) ────────────────────────────────────────
# Superuser credentials for PostgreSQL
POSTGRES_USER=forge
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=forge

# ─── Redis ────────────────────────────────────────────────────────
# Redis authentication password
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
# Max memory for Redis (e.g., 2gb, 4gb). Redis is the Celery broker and runs
# noeviction: at this limit writes are refused (RedisHighMemory alerts first), so size it
# for the deepest queue you expect, below the container's 3G limit.
REDIS_MAXMEMORY=2gb

# ─── Auth (Keycloak) ─────────────────────────────────────────────
# Keycloak admin console credentials
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
# OIDC realm name used by TrueNorth
KEYCLOAK_REALM=truenorth
# Token checks (docs/identity.md "Audience and issuer"). TN_ENV=production requires
# KEYCLOAK_AUDIENCE. Add the Keycloak audience mapper (the installer's roles/tn_keycloak
# adds it to the truenorth-identity scope) BEFORE setting it, or every user is locked out.
# KEYCLOAK_ISSUER is the realm's public URL, not KEYCLOAK_URL.
KEYCLOAK_AUDIENCE=truenorth-api
#KEYCLOAK_ISSUER=https://truenorth.example/realms/truenorth

# ─── JWT / API Auth ──────────────────────────────────────────────
# 256-bit secret for JWT signing (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ─── Object Storage (MinIO) ──────────────────────────────────────
# MinIO root credentials — also used by API and workers
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

# ─── Stored credentials ──────────────────────────────────────────
# Seals hypervisor passwords/tokens and AI engine keys in the database (app/secretbox.py).
# At least 32 random characters (openssl rand -hex 32). Never change it while credentials
# are stored: to rotate, set "new,old" and restart. Back it up with the database.
TN_SECRETS_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ─── AI Orchestrator ─────────────────────────────────────────────
# Backend: ollama | openai | anthropic | mock
AI_MODEL_BACKEND=ollama
# Comma-separated Ollama node URLs for fleet access
OLLAMA_NODES=http://ollama-1:11434,http://ollama-2:11434
# API keys — leave blank if using Ollama exclusively
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── OpenSearch ───────────────────────────────────────────────────
# Heap size for OpenSearch JVM (recommend half of allocated memory)
OPENSEARCH_HEAP=4g
# Security plugin on: TLS (internal CA) + basic auth. The installer generates all of
# this (install/README.md, "OpenSearch"); by hand you need the same files.
OPENSEARCH_DISABLE_SECURITY=false
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=CHANGE_ME_OPENSEARCH_ADMIN_PASSWORD
OPENSEARCH_DASHBOARDS_PASS=CHANGE_ME_OPENSEARCH_DASHBOARDS_PASSWORD
# Inside the api/worker containers: the CA mounted from OPENSEARCH_CERTS_DIR/ca.pem.
OPENSEARCH_VERIFY_SSL=/etc/truenorth/opensearch-ca.pem
# ca.pem, node.pem, node-key.pem (PKCS#8), admin.pem, admin-key.pem; owned by uid 1000.
OPENSEARCH_CERTS_DIR=/srv/truenorth/tls/opensearch
# admin + kibanaserver with bcrypt hashes of the two passwords above.
OPENSEARCH_INTERNAL_USERS=/srv/truenorth/config/opensearch/internal_users.yml
# Lab/dev override ONLY (no auth, plain http on the internal network):
#   OPENSEARCH_DISABLE_SECURITY=true  OPENSEARCH_URL=http://opensearch:9200  OPENSEARCH_USER=

# ─── Monitoring ───────────────────────────────────────────────────
# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
# Alertmanager. The default (alertmanager.yml) routes every alert to a NULL receiver:
# nothing is sent anywhere. For a real platform put the webhook URL in
# $ALERTMANAGER_SECRETS_DIR/webhook_url and select the webhook config:
#   ALERTMANAGER_CONFIG=alertmanager.webhook.yml
ALERTMANAGER_CONFIG=alertmanager.yml
#ALERTMANAGER_SECRETS_DIR=/srv/truenorth/config/alertmanager

# ─── Celery Flower (task dashboard) ──────────────────────────────
# Basic auth for Flower web UI
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_FLOWER_PASSWORD

# ─── Logging ──────────────────────────────────────────────────────
# Application log level: debug | info | warning | error
LOG_LEVEL=info
# json: one JSON object per line from the api and the Celery workers (for a log
# shipper). Anything else: plain text.
LOG_FORMAT=json

# ─── Celery task time limits (seconds) ────────────────────────────
# For every task without its own (range tasks keep 3300/3500, worker/fencing.py). The
# hard limit must stay below the broker's 3600 s visibility timeout: the workers refuse
# to start otherwise.
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=1900

# ═══════════════════════════════════════════════════════════════════
# Keys below are read by the application but were previously never passed
# through compose.prod.yml. Without them the stack starts and then fails at
# first use — the worst failure mode there is.
# ═══════════════════════════════════════════════════════════════════

# ─── Companion databases ──────────────────────────────────────────
# Keycloak and the LRS get their own databases. Sharing POSTGRES_DB puts ~90
# Keycloak tables beside the application's 68, and `alembic autogenerate` then
# proposes dropping all of them. Created by postgres-init/10-create-databases.sh.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
LRS_DB=lrs
LRS_DB_USER=lrs
LRS_DB_PASSWORD=CHANGE_ME_LRS_DB_PASSWORD

# ─── Learning Record Store (xAPI) ─────────────────────────────────
# LMS_BACKEND defaults to xapi_lrs in code, so an unset LRS_URL means every
# xAPI statement fails silently. Set LMS_BACKEND=null to disable deliberately.
LMS_BACKEND=xapi_lrs
LRS_URL=http://lrs:8080
LRS_ADMIN_USER=lrsadmin
LRS_ADMIN_PASSWORD=CHANGE_ME_LRS_ADMIN_PASSWORD
LRS_API_KEY=CHANGE_ME_LRS_API_KEY
LRS_API_SECRET=CHANGE_ME_LRS_API_SECRET
# base64("<LRS_API_KEY>:<LRS_API_SECRET>")
LRS_AUTH=CHANGE_ME_BASE64_KEY_COLON_SECRET

# ─── Provisioner ──────────────────────────────────────────────────
# Valid values (worker/provisioners/__init__.py): mock | proxmox_api |
# vsphere_api | hyperv | terraform | terraform_proxmox | terraform_vsphere |
# terraform_hyperv.  NOTE: plain "vsphere" and "proxmox" are NOT valid and
# raise ValueError at first provision. REQUIRED: compose.prod.yml has no default (it
# used to fall back to mock, which "builds" ranges without touching a hypervisor).
PROVISIONER_BACKEND=vsphere_api
# Proxmox (only when PROVISIONER_BACKEND=proxmox_api). These are the names the worker
# reads (control-plane/worker/worker/provisioners/proxmox_api.py); compose.prod.yml does
# not pass them through yet.
# PROXMOX_URL=https://CHANGE_ME_PROXMOX_HOST:8006
# PROXMOX_TOKEN_ID=CHANGE_ME_user@realm!tokenid
# PROXMOX_TOKEN_SECRET=CHANGE_ME
# PROXMOX_NODE=pve

# ─── vSphere ──────────────────────────────────────────────────────
# Read at module import by worker/provisioners/vsphere_api.py, so these must be
# in the worker environment at start-up.
VSPHERE_URL=https://vcenter.example.com
VSPHERE_USERNAME=svc-truenorth@vsphere.local
VSPHERE_PASSWORD=CHANGE_ME_VSPHERE_PASSWORD
VSPHERE_DATACENTER=DC-Lab
VSPHERE_CLUSTER=CL-Lab
VSPHERE_DATASTORE=esx04-local
VSPHERE_NETWORK=dPG-TN-MGMT
# Verify vCenter's TLS certificate (the compose default). false only for a lab vCenter
# with a self-signed certificate, and say so in your risk register.
VSPHERE_VERIFY_SSL=true

# ─── Active Directory / identity ──────────────────────────────────
LDAP_SERVER=dc01.corp.example.com
LDAP_PORT=636
LDAP_BASE_DN=DC=corp,DC=example,DC=com
# Set by the installer after creating the Keycloak LDAP federation component.
# The /ad-sync endpoints call Keycloak's sync API with this id.
KEYCLOAK_LDAP_COMPONENT_ID=

# ─── Trainee registration & onboarding ────────────────────────────
# AD groups that may register at all. Empty means "any authenticated AD user".
REGISTRATION_ALLOWED_GROUPS=TN-Students,TN-Instructors,TN-Range-Operators,TN-Platform-Admins,TN-Observers
# AD group -> suggested role on the approval screen. A suggestion only: approval
# is what actually assigns role and tenant.
REGISTRATION_GROUP_ROLE_MAP={"TN-Platform-Admins":"admin","TN-Range-Operators":"range_ops","TN-Instructors":"instructor","TN-Content-Authors":"instructor","TN-Students":"student","TN-Observers":"observer"}
REGISTRATION_DEFAULT_TENANT_SLUG=default
# Developmental progression a newly approved trainee is enrolled on (DP1 -> DP2).
REGISTRATION_DEFAULT_PROGRESSION=DP1

# ─── Schema ownership ─────────────────────────────────────────────
# Alembic owns the schema in production. The API lifespan otherwise runs
# create_all() and a dev seed on every start, racing migrations across all four
# uvicorn workers and minting a hardcoded admin@truenorth.local.
DB_AUTO_CREATE=false
SEED_DEV_DATA=false

# ─── Web / API security ───────────────────────────────────────────
# Double-submit CSRF cookie secret. Enforced by app/middleware.py. >= 32 characters.
CSRF_SECRET=CHANGE_ME_CSRF_SECRET_AT_LEAST_32_CHARS
# Bearer token the api and workers present to the AI orchestrator (>= 32 characters).
AI_SERVICE_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# GET /metrics needs `Authorization: Bearer <this>`. Prometheus reads it, and
# AI_SERVICE_TOKEN, from files in PROMETHEUS_SECRETS_DIR (metrics_scrape_token,
# ai_service_token).
METRICS_SCRAPE_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
PROMETHEUS_SECRETS_DIR=/srv/truenorth/config/prometheus
# Peers whose X-Forwarded-For is believed: nginx on the compose bridge networks.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.16.0.0/12
# Public origin of the calendar-feed URLs.
SCHEDULER_FEED_BASE_URL=https://CHANGE_ME.example.com
SEARCH_BACKEND=opensearch
