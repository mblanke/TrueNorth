# ═══════════════════════════════════════════════════════════════════
# TrueNorth Range — Production Environment Configuration
# Copy to .env.production and fill in all CHANGE_ME placeholders
# ═══════════════════════════════════════════════════════════════════

# ─── Domain & SSL ─────────────────────────────────────────────────
# Fully qualified domain name for the deployment
DOMAIN=CHANGE_ME.example.com
# Path on host to directory containing fullchain.pem and privkey.pem
SSL_CERT_PATH=/etc/ssl/truenorth

# ─── Database (PostgreSQL) ────────────────────────────────────────
# Superuser credentials for PostgreSQL
POSTGRES_USER=forge
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=forge

# ─── Redis ────────────────────────────────────────────────────────
# Redis authentication password
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
# Max memory for Redis cache (e.g., 2gb, 4gb)
REDIS_MAXMEMORY=2gb

# ─── Auth (Keycloak) ─────────────────────────────────────────────
# Keycloak admin console credentials
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
# OIDC realm name used by TrueNorth
KEYCLOAK_REALM=truenorth

# ─── JWT / API Auth ──────────────────────────────────────────────
# 256-bit secret for JWT signing (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ─── Object Storage (MinIO) ──────────────────────────────────────
# MinIO root credentials — also used by API and workers
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

# ─── AI Orchestrator ─────────────────────────────────────────────
# Backend: ollama | openai | anthropic | mock
AI_MODEL_BACKEND=ollama
# Comma-separated Ollama node URLs for fleet access
OLLAMA_NODES=http://ollama-1:11434,http://ollama-2:11434
# API keys — leave blank if using Ollama exclusively
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Provisioner ──────────────────────────────────────────────────
# Backend for range provisioning: proxmox | terraform | mock
PROVISIONER_BACKEND=proxmox
# Proxmox API connection (required when PROVISIONER_BACKEND=proxmox)
PROXMOX_API_URL=https://CHANGE_ME_PROXMOX_HOST:8006/api2/json
PROXMOX_TOKEN=CHANGE_ME_PROXMOX_API_TOKEN

# ─── OpenSearch ───────────────────────────────────────────────────
# Heap size for OpenSearch JVM (recommend half of allocated memory)
OPENSEARCH_HEAP=4g
# Set to true only for development; production should use security plugin
OPENSEARCH_DISABLE_SECURITY=false

# ─── Monitoring ───────────────────────────────────────────────────
# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ─── Celery Flower (task dashboard) ──────────────────────────────
# Basic auth for Flower web UI
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_FLOWER_PASSWORD

# ─── Logging ──────────────────────────────────────────────────────
# Application log level: debug | info | warning | error
LOG_LEVEL=info