<?xml version="1.0"?>
<!-- TrueNorth Range — pfSense bootstrap config (vSphere). Ported from the Proxmox seed:
     interface names changed vtnet0/vtnet1 -> vmx0/vmx1 (vmxnet3 under vSphere).
     This is the TEMPLATE's config only. Each range's firewall gets its own config.xml at
     deploy (control-plane/worker/worker/pfsense_config.py, delivered in guestinfo), which
     keeps this file's users, groups, web GUI/SSH settings and certificates. -->

<pfsense>
  <version>23.9</version>
  <system>
    <hostname>pfsense</hostname>
    <domain>range.local</domain>
    <timezone>Etc/UTC</timezone>
    <language>en_US</language>
    <dnsserver>1.1.1.1</dnsserver>
    <user>
      <name>admin</name>
      <descr>System Administrator</descr>
      <scope>system</scope>
      <groupname>admins</groupname>
      <bcrypt-hash>$2b$10$UGJ.X1F.FYK5VJne.Fv7ZuXGnFvL5JdR1mOsTnqMTOKP.BEU1DYNe</bcrypt-hash>
      <uid>0</uid>
      <priv>page-all</priv>
    </user>
    <group>
      <name>admins</name>
      <description>System Administrators</description>
      <scope>system</scope>
      <gid>110</gid>
      <member>0</member>
      <priv>page-all</priv>
    </group>
    <enablesshd>enabled</enablesshd>
    <sshport>22</sshport>
    <already_run_config_wizard/>
    <!-- TrueNorth: at boot, apply the per-range config the worker put in guestinfo
         (files/pfsense/tn-pfsense-config; needs the Open-VM-Tools package). Without a
         guestinfo config it does nothing, so the template itself boots as it is. -->
    <earlyshellcmd>/usr/local/bin/php -q /usr/local/sbin/tn-pfsense-config boot</earlyshellcmd>
  </system>

  <interfaces>
    <wan>
      <descr>WAN</descr>
      <if>vmx0</if>
      <enable/>
      <ipaddr>dhcp</ipaddr>
      <ipaddrv6>dhcp6</ipaddrv6>
      <blockpriv/>
      <blockbogons/>
    </wan>
    <lan>
      <descr>LAN</descr>
      <if>vmx1</if>
      <enable/>
      <ipaddr>10.0.1.1</ipaddr>
      <subnet>24</subnet>
    </lan>
  </interfaces>

  <dhcpd>
    <lan>
      <enable/>
      <range>
        <from>10.0.1.100</from>
        <to>10.0.1.254</to>
      </range>
      <defaultleasetime>7200</defaultleasetime>
      <maxleasetime>86400</maxleasetime>
    </lan>
  </dhcpd>

  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
  </nat>

  <filter>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet</ipprotocol>
      <source><network>lan</network></source>
      <destination><any/></destination>
      <descr>Default allow LAN to any</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <ipprotocol>inet6</ipprotocol>
      <source><network>lan</network></source>
      <destination><any/></destination>
      <descr>Default allow LAN IPv6 to any</descr>
    </rule>
  </filter>

  <syslog>
    <filterdescriptions>1</filterdescriptions>
  </syslog>
</pfsense>
