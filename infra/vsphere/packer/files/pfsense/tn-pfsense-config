#!/usr/local/bin/php -q
<?php
/*
 * TrueNorth Range - apply the per-range config.xml the worker put in guestinfo.
 *
 * Installed in the pfSense template as /usr/local/sbin/tn-pfsense-config (mode 0755),
 * with the Open-VM-Tools package. Usage:
 *
 *   tn-pfsense-config install   register "tn-pfsense-config boot" as an earlyshellcmd
 *                               in the running config (once, while building the template)
 *   tn-pfsense-config boot      (the earlyshellcmd) apply a new config, then reboot into it
 *   tn-pfsense-config apply     apply a new config, then /etc/rc.reload_all (no reboot)
 *   tn-pfsense-config status    print what guestinfo holds and what was applied
 *
 * The worker (control-plane/worker/worker/pfsense_config.py) sets, before first power-on:
 *   guestinfo.tn.pfsense.config  config.xml, gzip + base64
 *   guestinfo.tn.pfsense.ifmap   "vmx0=<mac> vmx1=<mac> ..." in vSphere NIC order
 *
 * On boot: no key -> nothing happens (the template boots as it is). Same content as last
 * applied (sha256 in /conf/tn-guestinfo.sha256) -> nothing happens. Otherwise the new
 * config is checked, its interface names are mapped to this guest's NICs by MAC, the
 * template's users, groups, web GUI/SSH settings, certificates and config version are
 * carried over from the config it replaces (guestinfo never holds credentials), the old
 * config is kept as /conf/config.xml.tn-previous, the new one is written atomically, and
 * the firewall reboots once into it. Any problem: log it, change nothing, exit 1.
 * Log: /conf/tn-pfsense-config.log (and syslog).
 *
 * OPNsense: the same script, installed in the OPNsense template as
 * /usr/local/sbin/tn-opnsense-config (the name selects the product). It reads
 * guestinfo.tn.opnsense.*, works on /conf/config.xml (root <opnsense>), and `install`
 * adds the boot hook /usr/local/etc/rc.syshook.d/early/50-tn-opnsense-config instead of
 * an earlyshellcmd (OPNsense has none). The worker renders that config with
 * pfsense_config.build_config(product="opnsense").
 */

// pfsense | opnsense: from the name the script was run as (TN_FIREWALL_PRODUCT in tests).
define('PRODUCT', getenv('TN_FIREWALL_PRODUCT') !== false ? (string)getenv('TN_FIREWALL_PRODUCT')
	: (strpos(basename(isset($argv[0]) ? $argv[0] : ''), 'opnsense') !== false ? 'opnsense' : 'pfsense'));
define('TN_SCRIPT', '/usr/local/sbin/tn-' . PRODUCT . '-config');
define('KEY_CONFIG', 'guestinfo.tn.' . PRODUCT . '.config');
define('KEY_IFMAP', 'guestinfo.tn.' . PRODUCT . '.ifmap');
// Test seam only (tests/worker/test_pfsense_config.py): a directory holding conf/,
// guestinfo/<key> files and ifconfig.txt, in place of the firewall. Never set on pfSense.
define('TEST_ROOT', (string)getenv('TN_PFSENSE_TEST_ROOT'));
define('CONF_DIR', TEST_ROOT !== '' ? TEST_ROOT . '/conf' : (PRODUCT === 'opnsense' ? '/conf' : '/cf/conf'));
define('CONF', CONF_DIR . '/config.xml');
define('STAMP', CONF_DIR . '/tn-guestinfo.sha256');
define('LOGFILE', CONF_DIR . '/tn-' . PRODUCT . '-config.log');
define('BOOT_COMMAND', '/usr/local/bin/php -q ' . TN_SCRIPT . ' boot');
// OPNsense runs every executable in rc.syshook.d/early before the network comes up.
define('OPNSENSE_HOOK', '/usr/local/etc/rc.syshook.d/early/50-tn-opnsense-config');
// Taken from the config being replaced, never from guestinfo.
const KEEP = array('version', 'system/user', 'system/group', 'system/nextuid', 'system/nextgid',
                   'system/webgui', 'system/ssh', 'system/enablesshd', 'cert', 'ca', 'sshdata');

function tnlog($msg) {
	$line = gmdate('Y-m-d\TH:i:s\Z') . " $msg\n";
	@file_put_contents(LOGFILE, $line, FILE_APPEND);
	if (function_exists('syslog')) {
		@openlog('tn-' . PRODUCT . '-config', LOG_PID, LOG_USER);
		@syslog(LOG_NOTICE, $msg);
	}
	echo 'tn-' . PRODUCT . "-config: $msg\n";
}

function fail($msg) {
	tnlog("NOT applied: $msg");
	exit(1);
}

function guestinfo($key) {
	if (TEST_ROOT !== '') {
		$f = TEST_ROOT . "/guestinfo/$key";
		return is_file($f) ? trim(file_get_contents($f)) : '';
	}
	$tools = array('/usr/local/bin/vmtoolsd --cmd ', '/usr/local/bin/vmware-rpctool ');
	foreach ($tools as $tool) {
		$out = array();
		$rc = 1;
		exec($tool . escapeshellarg("info-get $key") . ' 2>/dev/null', $out, $rc);
		if ($rc === 0) {
			return trim(implode("\n", $out));
		}
	}
	return '';
}

/* MAC address => interface name, for every NIC the kernel found. */
function local_macs() {
	$out = array();
	if (TEST_ROOT !== '') {
		$out = file(TEST_ROOT . '/ifconfig.txt', FILE_IGNORE_NEW_LINES);
	} else {
		exec('/sbin/ifconfig -a', $out);
	}
	$macs = array();
	$if = null;
	foreach ($out as $line) {
		if (preg_match('/^([A-Za-z0-9_.]+): flags=/', $line, $m)) {
			$if = $m[1];
		} elseif ($if !== null && preg_match('/^\s+(?:ether|hwaddr) ([0-9a-fA-F:]{17})/', $line, $m)) {
			$mac = strtolower($m[1]);
			if (!isset($macs[$mac])) {
				$macs[$mac] = $if;
			}
		}
	}
	return $macs;
}

/* Replace /<product>/<path> in $new with the same nodes from $cur (when $cur has them). */
function carry_over($new, $cur, $path) {
	$nx = new DOMXPath($new);
	$cx = new DOMXPath($cur);
	$src = $cx->query('/' . PRODUCT . "/$path");
	if ($src === false || $src->length === 0) {
		return;
	}
	foreach (iterator_to_array($nx->query('/' . PRODUCT . "/$path")) as $old) {
		$old->parentNode->removeChild($old);
	}
	$parts = explode('/', $path);
	array_pop($parts);
	$parent = $new->documentElement;
	foreach ($parts as $p) {
		$found = $nx->query($p, $parent)->item(0);
		if ($found === null) {
			$found = $parent->appendChild($new->createElement($p));
		}
		$parent = $found;
	}
	foreach ($src as $node) {
		$parent->appendChild($new->importNode($node, true));
	}
}

function install() {
	if (PRODUCT === 'opnsense') {
		$hook = "#!/bin/sh\n# TrueNorth: apply the per-range config from guestinfo (tn-opnsense-config)\n" . BOOT_COMMAND . "\n";
		if (is_file(OPNSENSE_HOOK) && file_get_contents(OPNSENSE_HOOK) === $hook) {
			echo "already installed\n";
			return 0;
		}
		@mkdir(dirname(OPNSENSE_HOOK), 0755, true);
		if (@file_put_contents(OPNSENSE_HOOK, $hook) !== strlen($hook) || !@chmod(OPNSENSE_HOOK, 0755)) {
			fail('cannot write ' . OPNSENSE_HOOK);
		}
		echo 'installed: ' . OPNSENSE_HOOK . ' -> ' . BOOT_COMMAND . "\n";
		return 0;
	}
	require_once('config.inc');
	require_once('util.inc');
	$cmds = config_get_path('system/earlyshellcmd', array());
	if (!is_array($cmds)) {
		$cmds = ($cmds === '') ? array() : array($cmds);
	}
	if (in_array(BOOT_COMMAND, $cmds, true)) {
		echo "already installed\n";
		return 0;
	}
	$cmds[] = BOOT_COMMAND;
	config_set_path('system/earlyshellcmd', $cmds);
	write_config('TrueNorth: apply the per-range config from guestinfo at boot');
	echo "installed: earlyshellcmd = " . BOOT_COMMAND . "\n";
	return 0;
}

function status() {
	$blob = guestinfo(KEY_CONFIG);
	$ifmap = guestinfo(KEY_IFMAP);
	echo "guestinfo config: " . ($blob === '' ? 'none' : strlen($blob) . ' bytes, sha256 ' .
		hash('sha256', $blob . "\n" . $ifmap)) . "\n";
	echo "guestinfo ifmap:  " . ($ifmap === '' ? 'none' : $ifmap) . "\n";
	echo "applied:          " . (is_file(STAMP) ? trim(file_get_contents(STAMP)) : 'never') . "\n";
	return 0;
}

function apply($mode) {
	$blob = guestinfo(KEY_CONFIG);
	if ($blob === '') {
		return 0;  // a template, or a VM TrueNorth did not configure: boot as is
	}
	$ifmap = guestinfo(KEY_IFMAP);
	$hash = hash('sha256', $blob . "\n" . $ifmap);
	if (is_file(STAMP) && trim(file_get_contents(STAMP)) === $hash) {
		return 0;  // already running this config
	}
	$raw = base64_decode($blob, true);
	$xml = ($raw === false) ? false : @gzdecode($raw);
	if ($xml === false) {
		fail(KEY_CONFIG . ' is not gzip+base64');
	}
	$new = new DOMDocument();
	$new->preserveWhiteSpace = false;
	$new->formatOutput = true;
	if (!@$new->loadXML($xml) || $new->documentElement->nodeName !== PRODUCT) {
		fail(KEY_CONFIG . ' is not a ' . PRODUCT . ' config.xml');
	}

	// vmxN in vSphere NIC order -> the name this guest gave the NIC with that MAC.
	$macs = local_macs();
	$rename = array();
	foreach (preg_split('/[\s,]+/', $ifmap, -1, PREG_SPLIT_NO_EMPTY) as $pair) {
		$kv = explode('=', $pair, 2);
		if (count($kv) !== 2) {
			fail("bad ifmap entry '$pair'");
		}
		$mac = strtolower($kv[1]);
		if (!isset($macs[$mac])) {
			fail("no NIC with MAC $mac (planned as {$kv[0]})");
		}
		$rename[$kv[0]] = $macs[$mac];
	}
	$nx = new DOMXPath($new);
	foreach ($nx->query('/' . PRODUCT . '/interfaces/*/if') as $node) {
		$name = trim($node->textContent);
		if (isset($rename[$name])) {
			$node->textContent = $rename[$name];
		} elseif ($ifmap !== '') {
			fail("interface $name is not in the ifmap");
		}
	}

	$cur = new DOMDocument();
	$cur->preserveWhiteSpace = false;
	if (!@$cur->load(CONF)) {
		fail('cannot read the current ' . CONF);
	}
	if ((new DOMXPath($cur))->query('/' . PRODUCT . '/system/user')->length === 0) {
		fail('the current config has no users to carry over; refusing to lock the firewall');
	}
	foreach (KEEP as $path) {
		carry_over($new, $cur, $path);
	}

	$out = $new->saveXML();
	$tmp = CONF . '.tn-new';
	if (@file_put_contents($tmp, $out) !== strlen($out)) {
		@unlink($tmp);
		fail("cannot write $tmp");
	}
	@copy(CONF, CONF . '.tn-previous');
	if (!@rename($tmp, CONF)) {
		@unlink($tmp);
		fail('cannot replace ' . CONF);
	}
	@unlink('/tmp/config.cache');
	file_put_contents(STAMP, "$hash\n");
	$names = array();
	foreach ($rename as $k => $v) {
		$names[] = "$k->$v";
	}
	tnlog("applied per-range config sha256=$hash (" . implode(' ', $names) . ")");
	if (TEST_ROOT !== '') {
		tnlog($mode === 'boot' ? 'would reboot' : 'would reload');
		return 0;
	}
	exec('/bin/sync');
	if ($mode === 'boot') {
		tnlog('rebooting into the per-range config');
		exec('/sbin/shutdown -r now "TrueNorth per-range config applied"');
	} else {
		exec(PRODUCT === 'opnsense' ? '/usr/local/etc/rc.reload_all' : '/etc/rc.reload_all');
	}
	return 0;
}

$mode = isset($argv[1]) ? $argv[1] : 'status';
switch ($mode) {
	case 'install':
		exit(install());
	case 'boot':
	case 'apply':
		exit(apply($mode));
	case 'status':
		exit(status());
	default:
		fwrite(STDERR, 'usage: tn-' . PRODUCT . "-config install|boot|apply|status\n");
		exit(2);
}
