# TrueNorth Range — vSphere Packer variables for the lab.
# Copy to lab.auto.pkrvars.hcl (git-ignored) and fill in the secrets. Values below are the
# real lab discovery output (vCenter 8.0.3, DC-Lab, ISOs on [esx01-local] ISO/). Cross-check
# against docs/deployment/vsphere-inventory.md before a run.

# --- vCenter ---------------------------------------------------------------
vcenter_server      = "192.168.1.10"          # or vcenter.truenorth.lab
vcenter_username    = "administrator@vsphere.local"
vcenter_password    = "CHANGE-ME"             # do NOT commit the real password
insecure_connection = true

# --- Placement -------------------------------------------------------------
vsphere_datacenter = "DC-Lab"
vsphere_cluster    = ""                        # empty: build on vsphere_host directly
# ISOs live on a HOST-LOCAL datastore, so the build MUST run on that host:
vsphere_host       = "192.168.1.11"            # esx01 (esx01.truenorth.lab)
vsphere_datastore  = "esx01-local"
vsphere_folder     = "TrueNorth/Templates"

# --- ISO media (already staged on [esx01-local] ISO/) ----------------------
iso_datastore = "esx01-local"
iso_folder    = "ISO"
# Present in the lab today (exact filenames):
iso_srv2022    = "en-us_windows_server_2022_updated_july_2026_x64_dvd_75aa9e18.iso"
iso_srv2025    = "en-us_windows_server_2025_updated_july_2026_x64_dvd_4e6f5a42.iso"
iso_win11_24h2 = "en-us_windows_11_consumer_editions_version_24h2_updated_feb_2026_x64_dvd_4e400c9e.iso"
iso_win11_26h1 = "en-us_windows_11_consumer_editions_version_26h1_updated_july_2026_x64_dvd_f69a9a1e.iso"
iso_ubuntu     = "ubuntu-24.04.4-live-server-amd64.iso"
iso_kali       = "kali-linux-2026.1-installer-everything-amd64.iso"
iso_rocky      = "Rocky-10.2-x86_64-dvd1.iso"
iso_debian     = "debian-13.6.0-amd64-DVD-1.iso"
iso_parrot     = "Parrot-security-7.3_amd64.iso"
# Downloaded 2026-10-03 to TrueNorth-Demo/ISO/ (signature-verified). Upload them to
# [esx01-local] ISO/ before building:
#   govc datastore.upload -ds esx01-local <file> ISO/<file>
iso_securityonion = "securityonion-2.4.211-20260407.iso"
iso_vyos          = "vyos-2026.10.01-0035-rolling-generic-amd64.iso"   # free rolling build; 1.4 LTS images need a subscription
# Reported on the datastore since discovery (2026-10-03). Set the EXACT file names from
# docs/deployment/vsphere-inventory.md (the discovery ISO table):
# iso_win10         = "<Windows 10 ISO>"
# iso_win10_ltsc    = "<Windows 10 LTSC 2021 ISO>"   # eval media: also gvlk_win10_ltsc = ""
# iso_srv2019       = "<Server 2019 ISO>"
# iso_srv2016       = "<Server 2016 ISO>"
# iso_pfsense       = "<pfSense CE ISO>"

# VMware Tools ISO (for the pvscsi WinPE driver). ESXi ships it at this path.
vmtools_iso_path = "[] /vmimages/tools-isoimages/windows.iso"

# --- Networking ------------------------------------------------------------
# Work site (ADR 0012): Packer runs on TN-MGMT01, whose second NIC (10.30.31.20) is on
# dPG-TN-BUILD (VLAN 31, 10.30.31.0/24): DHCP from TN-MGMT01, NO gateway and NO internet.
# Packages come from TN-DEPOT01 on that network (Depot, below). scripts/lab/pkrvars-work.py
# writes the work site's lab.auto.pkrvars.hcl (esx04, http_bind_address, ISOs) for you;
# docs/deployment/vmware-site-runbook.md §4.1a has the addresses.
build_network = "dPG-TN-BUILD"
# http_bind_address = "10.30.31.20"          # TN-MGMT01 ens224: Packer HTTP/WinRM/SSH callbacks
# pfsense_lan_network = "dPG-TN-BUILD"  # defaults to build_network if unset

# --- Output ----------------------------------------------------------------
content_library    = "TrueNorth-Templates"   # create first: govc library.create -ds esx01-local TrueNorth-Templates
publish_to_library = true                     # also keep inventory templates (always on)

# --- Depot (builds that install packages; empty = offline bases) -----------
# TN-DEPOT01 on its BUILD NIC, the address builds can reach. Nexus base URL WITH port and
# /repository: builds use <depot_url>/chocolatey and <depot_url>/installers/...
# (pkrvars-work.py --depot writes these two). Not 10.30.32.10: that is the depot's range
# uplink NIC, for ranges only, and build VMs are not on that network.
# depot_url = "http://10.30.31.30:8081/repository"
# apt_proxy = "http://10.30.31.30:3142"      # apt-cacher-ng, the apt/dnf forward proxy

# --- Build credentials (build-time only; sysprep/cloud-init reset on clone) -
windows_admin_password = "CHANGE-ME-Build1!"
ssh_username           = "ubuntu"
ssh_password           = "ubuntu"

# --- Windows 11 ------------------------------------------------------------
win11_vtpm = false   # true requires a vCenter key provider; false injects LabConfig bypasses

# --- Derived (vsphere-clone) base inventory templates ----------------------
# The existing cloud-image template tmpl-ubuntu-2404 can serve as the Ubuntu base directly:
# base_ubuntu_template = "tmpl-ubuntu-2404"
base_ubuntu_template = "ubuntu-lts"
base_win10_template  = "win10-22h2"
