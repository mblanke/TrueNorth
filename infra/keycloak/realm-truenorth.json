          "view-telemetry"
        ]
      }
    },
    {
      "username": "trainee@truenorth.local",
      "email": "trainee@truenorth.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "Trainee",
      "credentials": [
        {
          "type": "password",
          "value": "trainee",
