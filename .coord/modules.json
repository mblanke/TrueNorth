{
  "_comment": "Static config only. Mutable state (stage changes, blockers, notes, leases, locks, handoff) lives in .coord/state.sqlite. Path matching: most specific pattern wins (exact file > longest literal prefix); serialized_paths are checked before module ownership, then shared_paths.",
  "base_refs": ["github/main", "main"],
  "protected_branches": ["main", "master", "feat/aar-pdf-designer-xapi"],
  "worktree_hint": ".claude/worktrees/",
  "strict_leases": true,
  "stale_minutes": 90,
  "checkpoint_runs_gate": true,
  "gate_from_stage": 3,
  "checkpoint_gate_max_stage": 4,
  "gate_timeout_seconds": 840,
  "secret_regex": "(AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{36}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY)",
  "shared_paths": ["docs/**", "RESUME.md", "CHANGELOG.md"],
  "serialized_paths": [
    "control-plane/api/app/models.py",
    "control-plane/api/app/schemas.py",
    "control-plane/api/app/main.py",
    "control-plane/api/app/seed.py",
    "control-plane/api/app/task_contracts.py",
    "control-plane/api/app/rbac.py",
    "control-plane/api/app/routers/__init__.py",
    "control-plane/worker/worker/tasks.py",
    "control-plane/worker/worker/tables.py",
    "control-plane/worker/worker/db_ops.py",
    "control-plane/worker/worker/contracts.py",
    "control-plane/worker/worker/celery_app.py",
    "control-plane/api/alembic/**",
    "docs/interfaces/**",
    "control-plane/web/src/app/core/api/schema.d.ts",
    "control-plane/web/src/app/app.routes.ts",
    "tests/conftest.py",
    "tests/integration/conftest.py",
    ".dod-*-baseline",
    ".github/workflows/**"
  ],
  "stages": {
    "0": "spec",
    "1": "scaffolded",
    "2": "functional",
    "3": "tested",
    "4": "integrated",
    "5": "hardened",
    "6": "release-ready"
  },
  "gates": {
    "1": {"desc": "module skeleton exists: package, router/service entry",
          "commands": [], "manual": ["directory and entry point exist"]},
    "2": {"desc": "happy path works end-to-end locally",
          "commands": [], "manual": ["primary use case demonstrated in dev compose", "no TODO stubs on the happy path"]},
    "3": {"desc": "module unit tests pass; no breakage-class lint (F821/F811/E9) in module Python",
          "commands": [
            "{py} -m ruff check --no-fix --select F821,F811,E9 {pypaths}",
            "{py} -m pytest -q -p no:cacheprovider {tests}"
          ],
          "manual": ["error paths have at least one test each"]},
    "4": {"desc": "stage 3 + integration suite still collects (never starts stacks)",
          "commands": [
            "{py} -m ruff check --no-fix --select F821,F811,E9 {pypaths}",
            "{py} -m pytest -q -p no:cacheprovider {tests}",
            "{py} -m pytest -q -p no:cacheprovider --collect-only tests/integration"
          ],
          "manual": ["endpoints registered and in docs/interfaces/openapi.json", "UI route reachable", "integration flow passes in CI's integration job"]},
    "5": {"desc": "Definition of Done: scripts/dod.sh green (ruff + MOSA ratchets, contract drift, full pytest)",
          "commands": ["bash scripts/dod.sh"],
          "manual": ["multi-tenant isolation verified", "RBAC reviewed", "migration reversible"]},
    "6": {"desc": "merged to main, deployed to staging, smoke test green",
          "commands": ["bash scripts/dod.sh"],
          "manual": ["branch merged", "staging smoke test passed", "CHANGELOG entry"]}
  },
