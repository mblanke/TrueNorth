# ============================================================================
# TrueNorth Range - Environment Configuration
# Copy to .env and adjust values for your environment.
# ============================================================================

# -- Database (PostgreSQL) -------------------------------------------------
# Primary connection string (used by API, workers)
DATABASE_URL=postgresql+psycopg://forge:forge@postgres:5432/forge
# Connection pool tuning (per uvicorn worker)
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# -- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Auth (Keycloak) -------------------------------------------------------
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=truenorth
KEYCLOAK_CLIENT_ID=truenorth-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
# Set to "true" to bypass auth in local dev
AUTH_DISABLED=true

# -- Object Storage (MinIO / S3) -------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=truenorth-assets

# -- Search / Telemetry (OpenSearch) ---------------------------------------
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=forge-

# -- AI Engine (local vLLM via LiteLLM, air-gapped) -------------------------
# The orchestrator uses its OpenAI-compatible backend pointed at the local
# LiteLLM router (NOT the internet) — air-gapped from external LLM providers.
AI_MODEL_BACKEND=openai
OPENAI_BASE_URL=http://133.1.14.240:4000/v1
OPENAI_API_KEY=sk-r7725-local
# Per-capability LiteLLM model aliases. "agent" = Mistral 24B (serving today).
# Switch the heavy/general/code aliases to "forge" once Qwen 112B is deployed.
AI_HEAVY_MODEL=agent
AI_GENERAL_MODEL=agent
AI_CODE_MODEL=coder-fast
OPENAI_DEFAULT_MODEL=agent
# Author-time generations on a large model can run minutes — allow up to 10.
OPENAI_TIMEOUT_S=600
# Embeddings: "openai" routes through LiteLLM "embed"; "ollama" = legacy path.
AI_EMBED_BACKEND=openai
AI_EMBED_MODEL=embed
# Optional pin for the embedding width. Normally leave this UNSET: the API probes
# the served model and adopts the width it actually returns, and an existing
# index's width always wins over both (OpenSearch fixes knn_vector width at
# creation). Set it only to force a value when the model is unreachable at
# startup — bge-m3=1024, bge-small-en-v1.5=384. A pin that contradicts the live
# model is logged at WARNING and the model wins.
EMBED_DIM=
# Cloud providers are unused (air-gapped). Leave blank.
ANTHROPIC_API_KEY=
# Legacy Ollama fleet (unused in this deployment). "name=url" pairs if enabled.
OLLAMA_NODES=

# -- Provisioner Backend ---------------------------------------------------
# Valid values are the registry keys in worker/provisioners/__init__.py:
#   mock | proxmox_api | vsphere_api | hyperv
#   terraform | terraform_proxmox | terraform_vsphere | terraform_hyperv
# NOTE: bare "vsphere" and "proxmox" are NOT keys and raise ValueError at the
# first provision attempt. ("aws" and "azure" were never implemented at all.)
PROVISIONER_BACKEND=mock
# vSphere settings (when PROVISIONER_BACKEND=vsphere_api). With VSPHERE_URL empty
# the primary vSphere connection registered in the API is used instead.
VSPHERE_URL=
VSPHERE_USERNAME=
VSPHERE_PASSWORD=
VSPHERE_DATACENTER=
VSPHERE_CLUSTER=
VSPHERE_DATASTORE=
VSPHERE_VERIFY_SSL=false
# Range networking. Each range gets its own port groups (tn-<range8>-v<vlan>) on
# physical VLANs from VSPHERE_VLAN_POOL, which must be reserved for ranges and
# trunked to every host. vds: port groups on VSPHERE_RANGE_DVS; vss: on the
# standard switch VSPHERE_RANGE_VSWITCH of each host that runs a range VM.
VSPHERE_RANGE_SWITCH_MODE=vds
VSPHERE_RANGE_DVS=vDS-10G
VSPHERE_RANGE_VSWITCH=vSwitch1
VSPHERE_VLAN_POOL=100-199
# spread (each VM on the host with most vCPU headroom) | per-range-host | cluster
VSPHERE_PLACEMENT=spread
VSPHERE_RANGE_FOLDER=truenorth/ranges
# A host takes VMs while powered-on vCPUs <= threads x this.
VSPHERE_MAX_VCPU_PER_THREAD=4
# Hosts never used for range VMs. Set the host running the VCSA, e.g. esx01.truenorth.lab.
VSPHERE_EXCLUDE_HOSTS=
# Empty: clone inventory VM templates. Set: deploy OVF items of that name, if present.
VSPHERE_CONTENT_LIBRARY=
VSPHERE_CONCURRENCY=4
VSPHERE_TOOLS_TIMEOUT=120
VSPHERE_SNAPSHOT_TIMEOUT=1800
# Only for a VM with no VLAN at all (single-NIC smoke test); empty = such a VM fails.
VSPHERE_NETWORK=
# Range VMs are refused on these networks (comma-separated): never the management LAN.
VSPHERE_MGMT_NETWORK=dPG-TN-MGMT
# Depot uplink: the edge firewall of each range gets its WAN (NIC 0) on this network,
# with a static address from the pool. Empty = ranges fully isolated (no depot installs).
# Lab: dPG-TN-SVC, 10.30.32.100-10.30.32.199, gateway 10.30.32.1. Never a mgmt network.
VSPHERE_RANGE_UPLINK_NETWORK=
VSPHERE_RANGE_UPLINK_POOL=
VSPHERE_RANGE_UPLINK_GATEWAY=
VSPHERE_RANGE_UPLINK_PREFIX=24
# Software depot as range guests reach it (lab: http://10.30.32.10). Empty = node
# `services` are not installed at deploy time. Feed/proxy default to Nexus on the depot.
TN_DEPOT_URL=
TN_DEPOT_CHOCO_FEED=
TN_DEPOT_APT_PROXY=
# Per VM, all installs together; and the whole provision's cap (< Celery's 3600s).
TN_SOFTWARE_INSTALL_TIMEOUT=1800
VSPHERE_PROVISION_BUDGET=3300
# Proxmox settings (when PROVISIONER_BACKEND=proxmox_api)
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Optional node-name -> IP hints for discovery, e.g. "node1=10.0.0.5,node2=10.0.0.6"
PROXMOX_NODE_IPS=

# -- LTI 1.3 (Moodle integration) -------------------------------------------
# Public base URL of this API as seen by the LMS (used in deep-link items)
LTI_TOOL_BASE_URL=http://localhost:8980
# Public base URL of the web app (LTI launches redirect here)
LTI_WEB_BASE_URL=http://localhost:4200
# Mock provisioner delays (seconds)
MOCK_PROVISION_DELAY=3
MOCK_DESTROY_DELAY=2

# -- API Server ------------------------------------------------------------
API_PORT=8080
UVICORN_WORKERS=4
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# -- Rate Limiting ---------------------------------------------------------
# Requests per minute per user (0 = unlimited)
RATE_LIMIT_RPM=120
# Burst allowance above the rate limit
RATE_LIMIT_BURST=20

# -- Logging ---------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# JSON structured logging (true/false)
LOG_JSON=false

# -- App Metadata ----------------------------------------------------------
APP_VERSION=0.1.0