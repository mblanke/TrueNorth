# ============================================================================
# TrueNorth Range - Environment Configuration
# Copy to .env and adjust values for your environment.
# ============================================================================

# -- Database (PostgreSQL) -------------------------------------------------
# Primary connection string (used by API, workers)
DATABASE_URL=postgresql+psycopg://forge:forge@postgres:5432/forge
# Connection pool tuning (per uvicorn worker)
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# -- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Auth (Keycloak) -------------------------------------------------------
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=truenorth
KEYCLOAK_CLIENT_ID=truenorth-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
# Set to "true" to bypass auth in local dev
AUTH_DISABLED=true

# -- Object Storage (MinIO / S3) -------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=truenorth-assets

# -- Search / Telemetry (OpenSearch) ---------------------------------------
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=forge-

# -- AI Fleet --------------------------------------------------------------
AI_MODEL_BACKEND=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Comma-separated list of Ollama node URLs for local LLM inference
# Example: http://gpu-node-1:11434,http://gpu-node-2:11434
OLLAMA_NODES=

# -- Provisioner Backend ---------------------------------------------------
# Options: mock, proxmox, aws, azure
PROVISIONER_BACKEND=mock
# Proxmox settings (when PROVISIONER_BACKEND=proxmox)
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Optional node-name -> IP hints for discovery, e.g. "node1=10.0.0.5,node2=10.0.0.6"
PROXMOX_NODE_IPS=

# -- LTI 1.3 (Moodle integration) -------------------------------------------
# Public base URL of this API as seen by the LMS (used in deep-link items)
LTI_TOOL_BASE_URL=http://localhost:8980
# Public base URL of the web app (LTI launches redirect here)
LTI_WEB_BASE_URL=http://localhost:4200
# Mock provisioner delays (seconds)
MOCK_PROVISION_DELAY=3
MOCK_DESTROY_DELAY=2

# -- API Server ------------------------------------------------------------
API_PORT=8080
UVICORN_WORKERS=4
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# -- Rate Limiting ---------------------------------------------------------
# Requests per minute per user (0 = unlimited)
RATE_LIMIT_RPM=120
# Burst allowance above the rate limit
RATE_LIMIT_BURST=20

# -- Logging ---------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# JSON structured logging (true/false)
LOG_JSON=false

# -- App Metadata ----------------------------------------------------------
APP_VERSION=0.1.0