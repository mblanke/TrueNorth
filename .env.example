# ============================================================================
# TrueNorth Range - Environment Configuration
# Copy to .env and adjust values for your environment.
# ============================================================================

# -- Database (PostgreSQL) -------------------------------------------------
# Primary connection string (used by API, workers)
DATABASE_URL=postgresql+psycopg://forge:forge@postgres:5432/forge
# Connection pool tuning (per uvicorn worker)
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# -- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Auth (Keycloak) -------------------------------------------------------
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=truenorth
KEYCLOAK_CLIENT_ID=truenorth-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
# Set to "true" to bypass auth in local dev
AUTH_DISABLED=true

# -- Object Storage (MinIO / S3) -------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=truenorth-assets

# -- Search / Telemetry (OpenSearch) ---------------------------------------
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=forge-

# -- AI Engine (local vLLM via LiteLLM, air-gapped) -------------------------
# The orchestrator uses its OpenAI-compatible backend pointed at the local
# LiteLLM router (NOT the internet) — air-gapped from external LLM providers.
AI_MODEL_BACKEND=openai
OPENAI_BASE_URL=http://133.1.14.240:4000/v1
OPENAI_API_KEY=sk-r7725-local
# Per-capability LiteLLM model aliases. "agent" = Mistral 24B (serving today).
# Switch the heavy/general/code aliases to "forge" once Qwen 112B is deployed.
AI_HEAVY_MODEL=agent
AI_GENERAL_MODEL=agent
AI_CODE_MODEL=agent
OPENAI_DEFAULT_MODEL=agent
# Author-time generations on a large model can run minutes — allow up to 10.
OPENAI_TIMEOUT_S=600
# Embeddings: "openai" routes through LiteLLM "embed"; "ollama" = legacy path.
AI_EMBED_BACKEND=openai
AI_EMBED_MODEL=embed
# Set EMBED_DIM to the served embed model's dimensionality (bge-m3=1024,
# bge-small-en-v1.5=384). Mismatched vectors are dropped (text-only indexing).
EMBED_DIM=1024
# Cloud providers are unused (air-gapped). Leave blank.
ANTHROPIC_API_KEY=
# Legacy Ollama fleet (unused in this deployment). "name=url" pairs if enabled.
OLLAMA_NODES=

# -- Provisioner Backend ---------------------------------------------------
# Options: mock, proxmox, aws, azure
PROVISIONER_BACKEND=mock
# Proxmox settings (when PROVISIONER_BACKEND=proxmox)
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Optional node-name -> IP hints for discovery, e.g. "node1=10.0.0.5,node2=10.0.0.6"
PROXMOX_NODE_IPS=

# -- LTI 1.3 (Moodle integration) -------------------------------------------
# Public base URL of this API as seen by the LMS (used in deep-link items)
LTI_TOOL_BASE_URL=http://localhost:8980
# Public base URL of the web app (LTI launches redirect here)
LTI_WEB_BASE_URL=http://localhost:4200
# Mock provisioner delays (seconds)
MOCK_PROVISION_DELAY=3
MOCK_DESTROY_DELAY=2

# -- API Server ------------------------------------------------------------
API_PORT=8080
UVICORN_WORKERS=4
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# -- Rate Limiting ---------------------------------------------------------
# Requests per minute per user (0 = unlimited)
RATE_LIMIT_RPM=120
# Burst allowance above the rate limit
RATE_LIMIT_BURST=20

# -- Logging ---------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# JSON structured logging (true/false)
LOG_JSON=false

# -- App Metadata ----------------------------------------------------------
APP_VERSION=0.1.0